    printf("Digite o código da carta 2 (ex: A02): \n"); // Solicita o código da carta 2
    scanf("%3s", codigo2);

    printf("Digite a população da cidade 1: \n");   // Solicita a população da cidade 1
    scanf("%d", &populacao1);

    printf("Digite a população da cidade 2: \n");   // Solicita a população da cidade 2
    scanf("%d", &populacao2);

    printf("Digite a área da cidade 1: \n");   // Solicita a área da cidade 1
    scanf("%f", &area1);    

    printf("Digite a área da cidade 2: \n");    // Solicita a área da cidade 2
    scanf("%f", &area2);

    printf("Digite o PIB da cidade 1: \n");     // Solicita o PIB da cidade 1
    scanf("%f", &PIB1);

    printf("Digite o PIB da cidade 2: \n");   // Solicita o PIB da cidade 2
    scanf("%f", &PIB2); 

