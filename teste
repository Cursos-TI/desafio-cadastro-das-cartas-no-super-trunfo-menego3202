    int pontosTuristicos1; // pontos turísticos da cidade 1
    int pontosTuristicos2; // pontos turísticos da cidade 2


    printf("Digite uma letra de A - H para o primeiro Estado: \n");  // Solicita o prefixo do primeiro estado
    scanf(" %c", &estado1);

